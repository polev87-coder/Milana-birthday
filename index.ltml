<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Милана — 5 лет! 🎉</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: '#c6f91f',
            dark: '#05080A',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #05080A; color: #fff; overflow-x: hidden; }

    /* Confetti */
    .confetti-piece {
      position: fixed;
      width: 10px;
      height: 10px;
      top: -20px;
      z-index: 0;
      animation: confetti-fall linear infinite;
      pointer-events: none;
    }
    @keyframes confetti-fall {
      0% { transform: translateY(0) rotate(0deg); opacity: 1; }
      100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
    }

    /* Reveal */
    .reveal-element {
      opacity: 0;
      transform: translateY(30px);
      filter: blur(8px);
      transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .reveal-element.visible {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    /* Glow pulse */
    @keyframes glow-pulse {
      0%, 100% { box-shadow: 0 0 30px rgba(198,249,31,0.2), 0 0 60px rgba(198,249,31,0.1); }
      50% { box-shadow: 0 0 50px rgba(198,249,31,0.35), 0 0 100px rgba(198,249,31,0.15); }
    }
    .glow-box { animation: glow-pulse 3s ease-in-out infinite; }

    /* Float */
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }
    .float-anim { animation: float 3s ease-in-out infinite; }

    /* Sparkle */
    @keyframes sparkle {
      0%, 100% { opacity: 0; transform: scale(0); }
      50% { opacity: 1; transform: scale(1); }
    }

    /* Gift card hover */
    .gift-card {
      transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .gift-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }
    .gift-card.claimed {
      opacity: 0.55;
    }
    .gift-card.claimed .gift-name {
      text-decoration: line-through;
      text-decoration-color: #c6f91f;
    }

    /* Balloon */
    @keyframes balloon-float {
      0%, 100% { transform: translateY(0) rotate(-2deg); }
      33% { transform: translateY(-15px) rotate(2deg); }
      66% { transform: translateY(-8px) rotate(-1deg); }
    }
    .balloon { animation: balloon-float 4s ease-in-out infinite; }

    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0B0F13; }
    ::-webkit-scrollbar-thumb { background: rgba(198,249,31,0.3); border-radius: 3px; }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #c6f91f;
      color: #000;
      padding: 12px 24px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 14px;
      z-index: 9999;
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
      pointer-events: none;
    }
    .toast.show {
      transform: translateX(-50%) translateY(0);
    }

    /* Stars background */
    .star {
      position: absolute;
      width: 2px;
      height: 2px;
      background: #fff;
      border-radius: 50%;
      animation: sparkle 3s ease-in-out infinite;
    }

    /* Marketplace button */
    .market-btn {
      transition: all 0.3s ease;
    }
    .market-btn:hover {
      background: rgba(198,249,31,0.15);
      border-color: rgba(198,249,31,0.5);
    }
  </style>
</head>
<body>

  <!-- Toast -->
  <div id="toast" class="toast">🎉 Подарок отмечен!</div>

  <!-- Confetti container -->
  <div id="confetti-container"></div>

  <!-- NAV -->
  <nav class="sticky top-0 z-50 border-b border-white/5" style="background: rgba(5,8,10,0.85); backdrop-filter: blur(20px);">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🎀</span>
        <span class="text-sm font-semibold tracking-widest uppercase text-white/80">День рождения Миланы</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold tracking-widest uppercase text-brand">20.11.2026</span>
        <span class="w-2 h-2 rounded-full bg-brand" style="animation: sparkle 2s ease-in-out infinite;"></span>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-brand/5 blur-3xl float-anim"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full bg-pink-500/5 blur-3xl float-anim" style="animation-delay: 1s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-brand/3 blur-3xl"></div>

      <div class="balloon absolute top-16 left-[8%] text-6xl" style="animation-delay: 0s;">🎈</div>
      <div class="balloon absolute top-24 right-[12%] text-5xl" style="animation-delay: 0.5s;">🎈</div>
      <div class="balloon absolute top-12 left-[25%] text-4xl" style="animation-delay: 1.2s;">🎈</div>
      <div class="balloon absolute top-20 right-[30%] text-5xl" style="animation-delay: 0.8s;">🎈</div>

      <div class="star" style="top: 15%; left: 20%; animation-delay: 0s;"></div>
      <div class="star" style="top: 25%; left: 80%; animation-delay: 1s; width:3px; height:3px;"></div>
      <div class="star" style="top: 60%; left: 10%; animation-delay: 2s;"></div>
      <div class="star" style="top: 70%; left: 90%; animation-delay: 0.5s; width:3px; height:3px;"></div>
      <div class="star" style="top: 40%; left: 70%; animation-delay: 1.5s;"></div>
      <div class="star" style="top: 85%; left: 40%; animation-delay: 2.5s;"></div>
    </div>

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
      <div class="reveal-element inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand/20 bg-brand/5 mb-8">
        <span class="w-2 h-2 rounded-full bg-brand" style="animation: sparkle 2s ease-in-out infinite;"></span>
        <span class="text-xs font-semibold tracking-widest uppercase text-brand">Приглашение</span>
      </div>

      <h1 class="reveal-element text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.9] mb-6">
        <span class="text-white">Милана</span><br>
        <span class="text-brand">5 лет</span>
        <span class="inline-block ml-2" style="animation: float 2s ease-in-out infinite;">🎉</span>
      </h1>

      <div class="reveal-element flex items-center justify-center gap-4 mb-10" style="transition-delay: 0.2s;">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-brand/40"></div>
        <span class="text-lg sm:text-xl font-light text-white/70">20 ноября 2026</span>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-brand/40"></div>
      </div>

      <div class="reveal-element glow-box inline-grid grid-cols-4 gap-3 sm:gap-5 p-4 sm:p-6 rounded-2xl border border-brand/20 bg-white/[0.03]" style="backdrop-filter: blur(12px); transition-delay: 0.4s;">
        <div class="text-center">
          <div id="cd-days" class="text-3xl sm:text-5xl font-bold text-brand tabular-nums">---</div>
          <div class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-white/40 mt-2">дней</div>
        </div>
        <div class="text-center">
          <div id="cd-hours" class="text-3xl sm:text-5xl font-bold text-white tabular-nums">--</div>
          <div class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-white/40 mt-2">часов</div>
        </div>
        <div class="text-center">
          <div id="cd-mins" class="text-3xl sm:text-5xl font-bold text-white tabular-nums">--</div>
          <div class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-white/40 mt-2">минут</div>
        </div>
        <div class="text-center">
          <div id="cd-secs" class="text-3xl sm:text-5xl font-bold text-white/60 tabular-nums">--</div>
          <div class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-white/40 mt-2">секунд</div>
        </div>
      </div>

      <div class="reveal-element mt-16 flex flex-col items-center gap-2 text-white/30" style="transition-delay: 0.6s;">
        <span class="text-xs tracking-widest uppercase">Список подарков ниже</span>
        <div class="w-5 h-8 rounded-full border border-white/20 flex items-start justify-center p-1">
          <div class="w-1 h-2 rounded-full bg-brand" style="animation: float 1.5s ease-in-out infinite;"></div>
        </div>
      </div>
    </div>
  </section>

  <div class="h-px bg-gradient-to-r from-transparent via-brand/20 to-transparent"></div>

  <!-- ABOUT -->
  <section class="py-24 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <div class="reveal-element grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative group">
          <div class="aspect-square rounded-2xl border border-white/10 overflow-hidden bg-white/[0.02]">
            <img src="https://picsum.photos/seed/milana-birthday5/600/600.jpg" alt="Милана" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700">
          </div>
          <div class="absolute -bottom-4 -right-4 bg-brand text-black px-5 py-3 rounded-xl font-bold text-2xl shadow-lg" style="animation: float 3s ease-in-out infinite;">
            5 🎂
          </div>
          <div class="absolute -top-4 -left-4 grid grid-cols-3 gap-1.5 opacity-30">
            <div class="w-1.5 h-1.5 rounded-full bg-brand"></div><div class="w-1.5 h-1.5 rounded-full bg-brand"></div><div class="w-1.5 h-1.5 rounded-full bg-brand"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-brand"></div><div class="w-1.5 h-1.5 rounded-full bg-brand"></div><div class="w-1.5 h-1.5 rounded-full bg-brand"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-brand"></div><div class="w-1.5 h-1.5 rounded-full bg-brand"></div><div class="w-1.5 h-1.5 rounded-full bg-brand"></div>
          </div>
        </div>
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-brand/20 bg-brand/5 mb-6">
            <span class="text-[10px] font-semibold tracking-widest uppercase text-brand">О имениннице</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-6">
            Маленькая <span class="text-brand">принцесса</span> отмечает свой день!
          </h2>
          <p class="text-base text-white/60 font-light leading-relaxed mb-8">
            Милане исполняется 5 лет — самый волшебный возраст! Она обожает сказки, рисовать, танцевать и мечтает о настоящем приключении. Помогите сделать этот день незабываемым!
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="p-5 rounded-xl border border-white/10 bg-white/[0.02] group hover:bg-white/[0.04] transition-all duration-300">
              <div class="text-2xl mb-2">📅</div>
              <div class="text-[10px] font-semibold tracking-widest uppercase text-white/40 mb-1">Дата</div>
              <div class="text-sm font-medium">20 ноября</div>
            </div>
            <div class="p-5 rounded-xl border border-white/10 bg-white/[0.02] group hover:bg-white/[0.04] transition-all duration-300">
              <div class="text-2xl mb-2">⏰</div>
              <div class="text-[10px] font-semibold tracking-widest uppercase text-white/40 mb-1">Время</div>
              <div class="text-sm font-medium">14:00</div>
            </div>
            <div class="p-5 rounded-xl border border-white/10 bg-white/[0.02] group hover:bg-white/[0.04] transition-all duration-300">
              <div class="text-2xl mb-2">📍</div>
              <div class="text-[10px] font-semibold tracking-widest uppercase text-white/40 mb-1">Место</div>
              <div class="text-sm font-medium">Дома</div>
            </div>
            <div class="p-5 rounded-xl border border-white/10 bg-white/[0.02] group hover:bg-white/[0.04] transition-all duration-300">
              <div class="text-2xl mb-2">👗</div>
              <div class="text-[10px] font-semibold tracking-widest uppercase text-white/40 mb-1">Дресс-код</div>
              <div class="text-sm font-medium">Нарядный</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <!-- GIFTS -->
  <section class="py-24 px-6 relative" id="gifts">
    <div class="max-w-6xl mx-auto">
      <div class="reveal-element text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-brand/20 bg-brand/5 mb-6">
          <span class="text-[10px] font-semibold tracking-widest uppercase text-brand">Подарки</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
          Список <span class="text-brand">пожеланий</span> 🎁
        </h2>
        <p class="text-base text-white/50 font-light max-w-lg mx-auto">
          Выберите подарок, отметьте его как занятый и перейдите на маркетплейс, чтобы купить. Нажмите «Подарю» — и он будет зарезервирован.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="gifts-grid"></div>

      <div class="reveal-element mt-12 p-6 rounded-2xl border border-white/10 bg-white/[0.02] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand/10 flex items-center justify-center">
            <i data-lucide="gift" class="w-5 h-5 text-brand"></i>
          </div>
          <div>
            <div class="text-sm font-medium">Подарков в списке</div>
            <div class="text-xs text-white/40" id="gift-summary">0 из 0 отмечены</div>
          </div>
        </div>
        <button onclick="resetGifts()" class="px-5 py-2.5 rounded-lg border border-white/10 bg-white/5 text-xs font-semibold tracking-widest uppercase text-white/60 hover:text-white hover:border-white/20 hover:bg-white/10 transition-all duration-300 flex items-center gap-2">
          <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
          Сбросить
        </button>
      </div>
    </div>
  </section>

  <div class="h-px bg-gradient-to-r from-transparent via-brand/20 to-transparent"></div>

  <!-- WISHES -->
  <section class="py-24 px-6 relative">
    <div class="max-w-2xl mx-auto text-center">
      <div class="reveal-element">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-brand/20 bg-brand/5 mb-6">
          <span class="text-[10px] font-semibold tracking-widest uppercase text-brand">Пожелания</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-8">
          Напишите <span class="text-brand">Милане</span> поздравление ✨
        </h2>
      </div>
      <div class="reveal-element" style="transition-delay: 0.2s;">
        <textarea id="wish-input" rows="4" placeholder="Милана, с днём рождения! 🎂..." class="w-full p-5 rounded-xl border border-white/10 bg-white/[0.02] text-white placeholder-white/30 font-light text-base resize-none focus:outline-none focus:border-brand/40 focus:bg-white/[0.04] transition-all duration-300"></textarea>
        <button onclick="submitWish()" class="mt-4 px-8 py-3.5 rounded-xl bg-brand text-black text-xs font-semibold tracking-widest uppercase hover:shadow-lg hover:shadow-brand/20 transition-all duration-300 flex items-center gap-2 mx-auto">
          <i data-lucide="send" class="w-4 h-4"></i>
          Отправить
        </button>
      </div>
      <div id="wishes-list" class="mt-10 space-y-4 text-left"></div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-white/5 py-12 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <div class="text-3xl mb-4">🎀 🎂 🎁 🎈 🎉</div>
      <p class="text-sm text-white/40 font-light">
        С любовью для <span class="text-brand font-medium">Миланы</span> · 20.11.2026
      </p>
    </div>
  </footer>

  <script>
    // ====== GIFTS DATA with marketplace links ======
    const gifts = [
      { icon: '🧸', name: 'Большой плюшевый мишка', desc: 'Мягкий и уютный, для объятий', price: '3 000 ₽', url: 'https://www.wildberries.ru/catalog/igrushki/myagkie-igrushki/myagkaya-igrushka-medved' },
      { icon: '🎨', name: 'Набор для рисования', desc: 'Акварель, карандаши, фломастеры', price: '2 500 ₽', url: 'https://www.ozon.ru/category/nabory-dlya-risovaniya-7033/' },
      { icon: '🚲', name: 'Велосипед с колёсиками', desc: 'Розовый, с корзинкой и звонком', price: '8 000 ₽', url: 'https://www.wildberries.ru/catalog/dlya-doma/velosipedy' },
      { icon: '📚', name: 'Набор сказок с картинками', desc: 'Красочные издания любимых историй', price: '1 500 ₽', url: 'https://www.ozon.ru/category/detskie-knigi-7020/' },
      { icon: '🎭', name: 'Кукольный театр', desc: 'С куклами и ширмой для спектаклей', price: '4 000 ₽', url: 'https://www.wildberries.ru/catalog/igrushki/kukolnye-teatry' },
      { icon: '🧩', name: 'Большой пазл 200 деталей', desc: 'С принцессами и замком', price: '1 200 ₽', url: 'https://www.ozon.ru/category/pazly-15008/' },
      { icon: '👸', name: 'Наряд принцессы', desc: 'Платье, корона и волшебная палочка', price: '3 500 ₽', url: 'https://www.wildberries.ru/catalog/detskaya-odezhda/platya' },
      { icon: '🏠', name: 'Кукольный домик', desc: 'С мебелью и освещением', price: '6 000 ₽', url: 'https://www.ozon.ru/category/kukolnye-domiki-9/' },
      { icon: '🎶', name: 'Детское караоке', desc: 'С микрофоном и песенками', price: '2 800 ₽', url: 'https://www.wildberries.ru/catalog/igrushki/mikrofony-i-karaoke' },
    ];

    let claimedGifts = JSON.parse(localStorage.getItem('milana-claimed') || '[]');

    function renderGifts() {
      const grid = document.getElementById('gifts-grid');
      grid.innerHTML = '';

      gifts.forEach((gift, i) => {
        const isClaimed = claimedGifts.includes(i);
        const card = document.createElement('div');
        card.className = `reveal-element gift-card p-6 rounded-xl border ${isClaimed ? 'border-brand/30 bg-brand/5 claimed' : 'border-white/10 bg-white/[0.02]'}`;

        // Adjust layout: price top-right, buttons bottom
        card.innerHTML = `
          <div class="flex items-start justify-between mb-4">
            <span class="text-3xl">${gift.icon}</span>
            <span class="text-[10px] font-semibold tracking-widest uppercase ${isClaimed ? 'text-brand bg-brand/10' : 'text-white/30 bg-white/5'} px-2 py-1 rounded-full">${gift.price}</span>
          </div>
          
          <h3 class="gift-name text-base font-medium mb-1 leading-snug">${gift.name}</h3>
          <p class="text-xs text-white/40 font-light mb-5 leading-relaxed">${gift.desc}</p>
          
          <div class="flex flex-col gap-2.5">
            <!-- Marketplace link button -->
            <a href="${gift.url}" target="_blank" rel="noopener noreferrer" 
               onclick="event.stopPropagation();"
               class="market-btn w-full py-2.5 rounded-lg border border-white/10 bg-white/[0.03] text-[11px] font-semibold tracking-widest uppercase text-white/80 hover:text-brand flex items-cente
